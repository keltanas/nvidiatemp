[Unit]
Description=nvidiatemp — NVIDIA GPU fan controller daemon
Documentation=file:///usr/share/doc/nvidiatemp/README.md
# Only needed for the nvidia-settings backend (X display); NVML — the default
# backend — talks to the driver directly and needs no display manager.
After=network.target display-manager.service

[Service]
Type=simple
# Runs as root by default: NVML fan writes need root and the config file at
# /etc/nvidiatemp.yaml is readable.
ExecStart=/usr/local/bin/nvidiatemp run
# The nvidia-settings backend needs an X display. With the default backend
# (NVML) these are unnecessary; uncomment and set XAUTHORITY if you switch
# `backend: nvidia-settings` and the journal reports display errors.
# Environment=DISPLAY=:0
# Environment=XAUTHORITY=/home/<user>/.Xauthority
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
